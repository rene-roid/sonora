{
  "name": "sonora",
  "productName": "Sonora",
  "version": "0.2.0",
  "description": "A Spotify-like desktop client for Navidrome with synced lyrics, Fluent toasts, a mini-player and a taskbar-area visualizer widget.",
  "main": "./out/main/index.js",
  "author": "Sonora",
  "license": "MIT",
  "private": true,
  "scripts": {
    "go": "bun run scripts/go.ts",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "api:test": "bun run scripts/api-test.ts",
    "mock": "bun run scripts/mock-server.ts",
    "smoke": "bun run scripts/smoke.ts",
    "test": "bun test",
    "icons": "bun run scripts/gen-icons.ts",
    "dist": "bun run icons && electron-vite build && electron-builder --config electron-builder.yml",
    "dist:dir": "bun run icons && electron-vite build && electron-builder --dir --config electron-builder.yml"
  },
  "trustedDependencies": [
    "electron",
    "esbuild"
  ],
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@fluentui/tokens": "^1.0.0-alpha.21",
    "electron-store": "^8.2.0",
    "js-md5": "^0.8.3",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
